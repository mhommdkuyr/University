# Copy to .env for local development. Never commit real credentials.
ENVIRONMENT=production
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/university_platform
DATABASE_SSL_MODE=require
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=https://your-domain.example
AUTO_CREATE_SCHEMA=false
SEED_DEMO_DATA=false
AI_ENABLED=false
DEFAULT_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_FALLBACK_MODELS=
FRAPPE_EDUCATION_BASE_URL=
FRAPPE_EDUCATION_API_KEY=
FRAPPE_EDUCATION_API_SECRET=
FRAPPE_EDUCATION_STUDENT_NUMBER_FIELD=student_number
